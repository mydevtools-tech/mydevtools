{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyDevTools",
  "version": "0.1.18",
  "identifier": "tech.mydevtools.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @mydevtools/desktop-ui dev:tauri",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node ../desktop-ui/scripts/build-tauri.mjs",
    "frontendDist": "../../desktop-ui/out"
  },
  "app": {
    "windows": [
      {
        "title": "MyDevTools",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": { "x": 14, "y": 27 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/mydevtools-tech/mydevtools/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQTI5NjQwRjg5MjgwNjQKUldSa2dKTDRRSmFpc0Rqc21XWGdNSGVPNlp4YVlVV0JWdFpJVk9kYzBIdkx2MUFHNHZWc1VKUmsK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
